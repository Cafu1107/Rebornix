<Application x:Class="Rebornix.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Rebornix.Helpers"
             xmlns:vm="clr-namespace:Rebornix.ViewModels"
             xmlns:v="clr-namespace:Rebornix.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <h:BoolToVisibilityConverter x:Key="BoolToVis" />
            <h:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
            <h:InverseBoolConverter x:Key="InvBool" />
            <h:BytesConverter x:Key="Bytes" />
            <h:StatusToBrushConverter x:Key="StatusBrush" />
            <h:StatusToTextConverter x:Key="StatusText" />
            <h:LogLevelToBrushConverter x:Key="LogBrush" />
            <h:EqualsToVisibilityConverter x:Key="EqVis" />
            <h:PlusOneConverter x:Key="PlusOne" />
            <h:SameObjectConverter x:Key="SameObject" />

            <!-- Her sayfa modeli kendi görünümüyle eşleşir -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}"><v:HomeView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BackupViewModel}"><v:BackupView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RestoreViewModel}"><v:RestoreView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CatalogViewModel}"><v:CatalogView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DriversViewModel}"><v:DriversView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WifiViewModel}"><v:WifiView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WindowsSettingsViewModel}"><v:WindowsSettingsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogsViewModel}"><v:LogsView /></DataTemplate>

            <!-- Durum rozeti (bekliyor / yükleniyor / başarılı / hatalı ...) -->
            <DataTemplate x:Key="StatusBadge">
                <Border Style="{StaticResource Badge}" Background="{StaticResource Surface3Brush}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{Binding Converter={StaticResource StatusBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Converter={StaticResource StatusText}}" Style="{StaticResource BadgeText}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
