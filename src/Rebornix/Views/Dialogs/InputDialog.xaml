<Window x:Class="Rebornix.Views.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:Rebornix.Helpers"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="460" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">
    <Border Margin="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="24">
            <TextBlock x:Name="TitleText" Style="{StaticResource H2}" MouseLeftButtonDown="OnDrag" />
            <TextBlock x:Name="PromptText" Style="{StaticResource Body}" Margin="0,12,0,8" />
            <TextBox x:Name="ValueBox" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="{h:Loc Btn_Ok}" Style="{StaticResource AccentButton}" MinWidth="96" IsDefault="True" Click="OnOk" />
                <Button Content="{h:Loc Btn_Cancel}" MinWidth="96" Margin="10,0,0,0" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
