<Window x:Class="Rebornix.Views.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">
    <Border Margin="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" MouseLeftButtonDown="OnDrag" Background="Transparent">
                <Border x:Name="IconBg" Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                    <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" HorizontalAlignment="Center" FontSize="18" />
                </Border>
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="400" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" Margin="0,16,0,0" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" Style="{StaticResource Body}" />
            </ScrollViewer>
            <StackPanel x:Name="Buttons" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0" />
        </Grid>
    </Border>
</Window>
