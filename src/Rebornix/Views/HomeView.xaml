<UserControl x:Class="Rebornix.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="clr-namespace:Rebornix.Helpers"
             xmlns:vm="clr-namespace:Rebornix.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:HomeViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">
            <DockPanel Margin="0,0,0,22">
                <Button DockPanel.Dock="Right" Command="{Binding ShowGuideCommand}" VerticalAlignment="Center" Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{h:Loc Home_Guide}" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{h:Loc Home_Title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{h:Loc Home_Subtitle}" Style="{StaticResource Dim}" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource WarnBanner}" Margin="0,0,0,18" Visibility="{Binding IsDryRun, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{h:Loc Dry_Banner}" Style="{StaticResource Body}" />
            </Border>

            <!-- Üç mod kartı -->
            <UniformGrid Columns="3">
                <Button Style="{StaticResource ModeCardButton}" Command="{Binding GoBackupCommand}" Margin="0,0,10,0">
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="15" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center" Foreground="White" />
                        </Border>
                        <TextBlock Text="{h:Loc Home_BackupTitle}" Style="{StaticResource H2}" Margin="0,16,0,6" />
                        <TextBlock Text="{h:Loc Home_BackupDesc}" Style="{StaticResource Dim}" />
                        <Border Style="{StaticResource Badge}" Margin="0,14,0,0" Background="#2660A5FA" BorderBrush="#4460A5FA">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#FF60A5FA" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{h:Loc Home_BackupBadge}" Style="{StaticResource BadgeText}" Foreground="#FFBFDBFE" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ModeCardButton}" Command="{Binding GoRestoreCommand}" Margin="5,0,5,0">
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="15" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center" Foreground="White" />
                        </Border>
                        <TextBlock Text="{h:Loc Home_RestoreTitle}" Style="{StaticResource H2}" Margin="0,16,0,6" />
                        <TextBlock Text="{h:Loc Home_RestoreDesc}" Style="{StaticResource Dim}" />
                        <Border Style="{StaticResource Badge}" Margin="0,14,0,0" Background="#2634D399" BorderBrush="#4434D399">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#FF34D399" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{h:Loc Home_RestoreBadge}" Style="{StaticResource BadgeText}" Foreground="#FFA7F3D0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ModeCardButton}" Command="{Binding GoCatalogCommand}" Margin="10,0,0,0">
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="15" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center" Foreground="White" />
                        </Border>
                        <TextBlock Text="{h:Loc Home_CatalogTitle}" Style="{StaticResource H2}" Margin="0,16,0,6" />
                        <TextBlock Text="{h:Loc Home_CatalogDesc}" Style="{StaticResource Dim}" />
                        <Border Style="{StaticResource Badge}" Margin="0,14,0,0" Background="#26F472B6" BorderBrush="#44F472B6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#FFF472B6" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{h:Loc Home_CatalogBadge}" Style="{StaticResource BadgeText}" Foreground="#FFFBCFE8" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Son işlem özeti -->
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SummaryTime}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBlock Text="{h:Loc Home_LastSummary}" Style="{StaticResource H3}" />
                        </DockPanel>
                        <TextBlock Text="{Binding SummaryTitle}" Style="{StaticResource Dim}" Margin="0,6,0,10" />
                        <ItemsControl ItemsSource="{Binding SummaryLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Ortam durumu -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding CheckEnvironmentCommand}"
                                    ToolTip="{h:Loc Btn_Refresh}" />
                            <TextBlock Text="{h:Loc Home_Environment}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Ellipse Width="9" Height="9" Margin="0,0,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdminOk}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding AdminStatus}" Style="{StaticResource Body}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="9" Height="9" Margin="0,0,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WingetOk}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding WingetStatus}" Style="{StaticResource Body}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="9" Height="9" Margin="0,0,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InternetOk}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding InternetStatus}" Style="{StaticResource Body}" />
                        </StackPanel>
                        <Border Style="{StaticResource Banner}" Margin="0,16,0,0">
                            <TextBlock Text="{h:Loc Home_BrowserNote}" Style="{StaticResource Caption}" Foreground="{StaticResource TextBrush}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
