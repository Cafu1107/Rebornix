<UserControl x:Class="Rebornix.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="clr-namespace:Rebornix.Helpers"
             xmlns:vm="clr-namespace:Rebornix.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:LogsViewModel}">
    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{h:Loc Logs_OpenCurrent}" Command="{Binding OpenLogFileCommand}" Margin="0,0,8,0" />
                <Button Content="{h:Loc Logs_OpenFolder}" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0" />
                <Button Content="{h:Loc Logs_ClearView}" Command="{Binding ClearViewCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{h:Loc Logs_Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{h:Loc Logs_Subtitle}" Style="{StaticResource Dim}" Margin="0,6,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <ListBox ItemsSource="{Binding Entries}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PlainItem}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Level}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                       Foreground="{Binding Level, Converter={StaticResource LogBrush}}" />
                            <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{Binding Level, Converter={StaticResource LogBrush}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" Padding="12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshFilesCommand}" />
                    <TextBlock Text="{h:Loc Logs_Files}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox ItemsSource="{Binding Files}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PlainItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.OpenLogFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
