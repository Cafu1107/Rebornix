<UserControl x:Class="Rebornix.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="clr-namespace:Rebornix.Helpers"
             xmlns:vm="clr-namespace:Rebornix.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:WelcomeViewModel}"
             d:DesignWidth="1280" d:DesignHeight="800">
    <UserControl.Resources>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
        <SineEase x:Key="Sine" EasingMode="EaseInOut" />

        <!-- Slayt görünür olunca sağdan kayarak ve belirerek gelir -->
        <Style x:Key="Slide" TargetType="Grid">
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="70" To="0" Duration="0:0:0.6" EasingFunction="{StaticResource EaseOut}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Kicker" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentGradientH}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BigTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="44" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="Lead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#FFB4BCD0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="620" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <!-- Küçük simge çipi -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,5" />
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <!-- Sürekli animasyonlar -->
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="Orb1Shift" Storyboard.TargetProperty="X" From="-40" To="60" Duration="0:0:9" EasingFunction="{StaticResource Sine}" />
                    <DoubleAnimation Storyboard.TargetName="Orb1Shift" Storyboard.TargetProperty="Y" From="-20" To="40" Duration="0:0:7" EasingFunction="{StaticResource Sine}" />
                    <DoubleAnimation Storyboard.TargetName="Orb2Shift" Storyboard.TargetProperty="X" From="50" To="-50" Duration="0:0:11" EasingFunction="{StaticResource Sine}" />
                    <DoubleAnimation Storyboard.TargetName="Orb2Shift" Storyboard.TargetProperty="Y" From="30" To="-40" Duration="0:0:8" EasingFunction="{StaticResource Sine}" />
                    <DoubleAnimation Storyboard.TargetName="Orb3Shift" Storyboard.TargetProperty="X" From="-30" To="40" Duration="0:0:10" EasingFunction="{StaticResource Sine}" />
                    <DoubleAnimation Storyboard.TargetName="LogoFloat" Storyboard.TargetProperty="Y" From="-7" To="7" Duration="0:0:2.6" EasingFunction="{StaticResource Sine}" />
                    <DoubleAnimation Storyboard.TargetName="Tile1Float" Storyboard.TargetProperty="Y" From="-6" To="6" Duration="0:0:2.4" EasingFunction="{StaticResource Sine}" />
                    <DoubleAnimation Storyboard.TargetName="Tile2Float" Storyboard.TargetProperty="Y" From="6" To="-6" Duration="0:0:2.8" EasingFunction="{StaticResource Sine}" />
                    <DoubleAnimation Storyboard.TargetName="Tile3Float" Storyboard.TargetProperty="Y" From="-5" To="7" Duration="0:0:2.2" EasingFunction="{StaticResource Sine}" />
                    <DoubleAnimation Storyboard.TargetName="DiskGlow" Storyboard.TargetProperty="Opacity" From="0.35" To="0.9" Duration="0:0:1.4" EasingFunction="{StaticResource Sine}" />
                </Storyboard>
            </BeginStoryboard>
            <!-- Logonun etrafında yayılan halkalar -->
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" Duration="0:0:2.4">
                    <DoubleAnimation Storyboard.TargetName="Ring1Scale" Storyboard.TargetProperty="ScaleX" From="0.8" To="1.7" Duration="0:0:2.4" EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="Ring1Scale" Storyboard.TargetProperty="ScaleY" From="0.8" To="1.7" Duration="0:0:2.4" EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="Ring1" Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:2.4" />
                </Storyboard>
            </BeginStoryboard>
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" Duration="0:0:2.4" BeginTime="0:0:1.2">
                    <DoubleAnimation Storyboard.TargetName="Ring2Scale" Storyboard.TargetProperty="ScaleX" From="0.8" To="1.7" Duration="0:0:2.4" EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="Ring2Scale" Storyboard.TargetProperty="ScaleY" From="0.8" To="1.7" Duration="0:0:2.4" EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="Ring2" Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:2.4" />
                </Storyboard>
            </BeginStoryboard>
            <!-- Diske akan noktalar -->
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" Duration="0:0:1.8">
                    <DoubleAnimation Storyboard.TargetName="Dot1Shift" Storyboard.TargetProperty="X" From="0" To="150" Duration="0:0:1.8" />
                    <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:1.8" />
                    <DoubleAnimation Storyboard.TargetName="Dot2Shift" Storyboard.TargetProperty="X" From="0" To="150" Duration="0:0:1.8" BeginTime="0:0:0.6" />
                    <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:1.2" BeginTime="0:0:0.6" />
                    <DoubleAnimation Storyboard.TargetName="Dot3Shift" Storyboard.TargetProperty="X" From="0" To="150" Duration="0:0:1.8" BeginTime="0:0:1.2" />
                    <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.6" BeginTime="0:0:1.2" />
                </Storyboard>
            </BeginStoryboard>
            <!-- Format sonrası adımların sırayla yanması -->
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" Duration="0:0:6">
                    <DoubleAnimation Storyboard.TargetName="ProgressScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:4.5" EasingFunction="{StaticResource Sine}" />
                    <DoubleAnimation Storyboard.TargetName="Step1On" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" BeginTime="0:0:0.1" />
                    <DoubleAnimation Storyboard.TargetName="Step2On" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" BeginTime="0:0:1.2" />
                    <DoubleAnimation Storyboard.TargetName="Step3On" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" BeginTime="0:0:2.3" />
                    <DoubleAnimation Storyboard.TargetName="Step4On" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" BeginTime="0:0:3.4" />
                    <DoubleAnimation Storyboard.TargetName="Step5On" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" BeginTime="0:0:4.5" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid ClipToBounds="True">
        <!-- ═══════ Arka plan ═══════ -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF090B12" Offset="0" />
                    <GradientStop Color="#FF100E26" Offset="0.55" />
                    <GradientStop Color="#FF0A1224" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-220,0,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#708B5CF6" Offset="0" />
                    <GradientStop Color="#008B5CF6" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform><TranslateTransform x:Name="Orb1Shift" /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-300">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#603B82F6" Offset="0" />
                    <GradientStop Color="#003B82F6" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform><TranslateTransform x:Name="Orb2Shift" /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,120,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#406366F1" Offset="0" />
                    <GradientStop Color="#006366F1" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform><TranslateTransform x:Name="Orb3Shift" /></Ellipse.RenderTransform>
        </Ellipse>
        <!-- İnce ızgara dokusu -->
        <Rectangle Opacity="0.5">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,44,44" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Geometry="M 0,0 L 44,0 M 0,0 L 0,44">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#0DFFFFFF" Thickness="1" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="40,26,40,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Üst çubuk -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Foreground="#FFB4BCD0" Command="{Binding FinishCommand}"
                        Content="{h:Loc Wel_Skip}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource LogoImage}" Width="30" Height="30" />
                    <TextBlock Text="Rebornix" Foreground="White" FontSize="17" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- ═══════ Slaytlar ═══════ -->
            <Grid Grid.Row="1" MaxWidth="1000" VerticalAlignment="Center">

                <!-- 1: Hoş geldin -->
                <Grid Style="{StaticResource Slide}" Visibility="{Binding Index, Converter={StaticResource EqVis}, ConverterParameter=0}">
                    <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                    <StackPanel>
                        <Grid Width="320" Height="250" HorizontalAlignment="Center">
                            <Ellipse Width="260" Height="260" Margin="-10">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#607B61FF" Offset="0" />
                                        <GradientStop Color="#007B61FF" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="Ring1" Width="160" Height="160" Stroke="{StaticResource AccentGradientH}" StrokeThickness="2" RenderTransformOrigin="0.5,0.5" Opacity="0">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="Ring1Scale" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Ring2" Width="160" Height="160" Stroke="{StaticResource AccentGradientH}" StrokeThickness="2" RenderTransformOrigin="0.5,0.5" Opacity="0">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="Ring2Scale" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Image Source="{StaticResource LogoImage}" Width="140" Height="140">
                                <Image.RenderTransform><TranslateTransform x:Name="LogoFloat" /></Image.RenderTransform>
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.55" Color="#FF3B1FA8" />
                                </Image.Effect>
                            </Image>
                        </Grid>
                        <TextBlock Text="{h:Loc Wel_S1_Kicker}" Style="{StaticResource Kicker}" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource BigTitle}" FontSize="52">
                            <Run Text="Rebornix" Foreground="{StaticResource AccentGradientH}" />
                        </TextBlock>
                        <TextBlock Text="{h:Loc Wel_S1_Title}" Style="{StaticResource BigTitle}" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="{h:Loc Wel_S1_Text}" Style="{StaticResource Lead}" />
                    </StackPanel>
                </Grid>

                <!-- 2: Formattan önce -->
                <Grid Style="{StaticResource Slide}" Visibility="{Binding Index, Converter={StaticResource EqVis}, ConverterParameter=1}">
                    <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                    <StackPanel>
                        <Grid Height="270" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE964;" Style="{StaticResource Icon}" Foreground="#FFA78BFA" Margin="0,0,10,0" />
                                        <TextBlock Text="{h:Loc Wel_Chip_Drivers}" Foreground="White" FontSize="14" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE701;" Style="{StaticResource Icon}" Foreground="#FF93A5FB" Margin="0,0,10,0" />
                                        <TextBlock Text="{h:Loc Wel_Chip_Wifi}" Foreground="White" FontSize="14" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" Foreground="#FF818CF8" Margin="0,0,10,0" />
                                        <TextBlock Text="{h:Loc Wel_Chip_Apps}" Foreground="White" FontSize="14" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" Foreground="#FF7DA2F9" Margin="0,0,10,0" />
                                        <TextBlock Text="{h:Loc Wel_Chip_Games}" Foreground="White" FontSize="14" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Foreground="#FF60A5FA" Margin="0,0,10,0" />
                                        <TextBlock Text="{h:Loc Wel_Chip_Settings}" Foreground="White" FontSize="14" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- Akış -->
                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                <Rectangle Height="2" RadiusX="1" RadiusY="1" Fill="#22FFFFFF" />
                                <Ellipse x:Name="Dot1" Width="10" Height="10" Fill="{StaticResource AccentGradientH}" HorizontalAlignment="Left">
                                    <Ellipse.RenderTransform><TranslateTransform x:Name="Dot1Shift" /></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="Dot2" Width="10" Height="10" Fill="{StaticResource AccentGradientH}" HorizontalAlignment="Left" Opacity="0">
                                    <Ellipse.RenderTransform><TranslateTransform x:Name="Dot2Shift" /></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="Dot3" Width="10" Height="10" Fill="{StaticResource AccentGradientH}" HorizontalAlignment="Left" Opacity="0">
                                    <Ellipse.RenderTransform><TranslateTransform x:Name="Dot3Shift" /></Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <!-- Disk -->
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Border x:Name="DiskGlow" Width="150" Height="150" CornerRadius="38" Background="{StaticResource AccentGradient}" Opacity="0.5">
                                    <Border.Effect><BlurEffect Radius="40" /></Border.Effect>
                                </Border>
                                <Border Width="150" Height="150" CornerRadius="38" Background="{StaticResource AccentGradient}">
                                    <Border CornerRadius="38" BorderThickness="0,1.5,0,0" BorderBrush="#55FFFFFF">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="58" Foreground="White" HorizontalAlignment="Center" />
                                            <TextBlock Text="{h:Loc Wel_Disk}" Foreground="#E6FFFFFF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Border>
                                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="#FF0A0C13" FontSize="16" HorizontalAlignment="Center" FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </Grid>
                        <TextBlock Text="{h:Loc Wel_S2_Kicker}" Style="{StaticResource Kicker}" Margin="0,10,0,0" />
                        <TextBlock Text="{h:Loc Wel_S2_Title}" Style="{StaticResource BigTitle}" />
                        <TextBlock Text="{h:Loc Wel_S2_Text}" Style="{StaticResource Lead}" />
                    </StackPanel>
                </Grid>

                <!-- 3: Formattan sonra -->
                <Grid Style="{StaticResource Slide}" Visibility="{Binding Index, Converter={StaticResource EqVis}, ConverterParameter=2}">
                    <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                    <StackPanel>
                        <Grid Height="270" Width="660" HorizontalAlignment="Center">
                            <!-- Çizgi ve dolan ilerleme -->
                            <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="#1FFFFFFF" Margin="52,0,52,26" VerticalAlignment="Center" />
                            <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentGradientH}" Margin="52,0,52,26" VerticalAlignment="Center"
                                       RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="ProgressScale" ScaleX="0" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <UniformGrid Columns="5" VerticalAlignment="Center">
                                <StackPanel>
                                    <Grid Width="68" Height="68">
                                        <Border CornerRadius="34" Background="#FF1B2030" BorderBrush="#33FFFFFF" BorderThickness="1" />
                                        <Border x:Name="Step1On" CornerRadius="34" Background="{StaticResource AccentGradient}" Opacity="0" />
                                        <TextBlock Text="&#xE964;" Style="{StaticResource Icon}" FontSize="26" Foreground="White" HorizontalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{h:Loc Wel_Chip_Drivers}" Foreground="#FFB4BCD0" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <Grid Width="68" Height="68">
                                        <Border CornerRadius="34" Background="#FF1B2030" BorderBrush="#33FFFFFF" BorderThickness="1" />
                                        <Border x:Name="Step2On" CornerRadius="34" Background="{StaticResource AccentGradient}" Opacity="0" />
                                        <TextBlock Text="&#xE701;" Style="{StaticResource Icon}" FontSize="26" Foreground="White" HorizontalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{h:Loc Wel_Chip_Wifi}" Foreground="#FFB4BCD0" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <Grid Width="68" Height="68">
                                        <Border CornerRadius="34" Background="#FF1B2030" BorderBrush="#33FFFFFF" BorderThickness="1" />
                                        <Border x:Name="Step3On" CornerRadius="34" Background="{StaticResource AccentGradient}" Opacity="0" />
                                        <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="26" Foreground="White" HorizontalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{h:Loc Wel_Chip_Apps}" Foreground="#FFB4BCD0" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <Grid Width="68" Height="68">
                                        <Border CornerRadius="34" Background="#FF1B2030" BorderBrush="#33FFFFFF" BorderThickness="1" />
                                        <Border x:Name="Step4On" CornerRadius="34" Background="{StaticResource AccentGradient}" Opacity="0" />
                                        <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="26" Foreground="White" HorizontalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{h:Loc Wel_Chip_Games}" Foreground="#FFB4BCD0" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <Grid Width="68" Height="68">
                                        <Border CornerRadius="34" Background="#FF1B2030" BorderBrush="#33FFFFFF" BorderThickness="1" />
                                        <Border x:Name="Step5On" CornerRadius="34" Background="{StaticResource AccentGradient}" Opacity="0" />
                                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="26" Foreground="White" HorizontalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{h:Loc Wel_Chip_Settings}" Foreground="#FFB4BCD0" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                        <TextBlock Text="{h:Loc Wel_S3_Kicker}" Style="{StaticResource Kicker}" Margin="0,10,0,0" />
                        <TextBlock Text="{h:Loc Wel_S3_Title}" Style="{StaticResource BigTitle}" />
                        <TextBlock Text="{h:Loc Wel_S3_Text}" Style="{StaticResource Lead}" />
                    </StackPanel>
                </Grid>

                <!-- 4: Güvenli ve kolay + başla -->
                <Grid Style="{StaticResource Slide}" Visibility="{Binding Index, Converter={StaticResource EqVis}, ConverterParameter=3}">
                    <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                    <StackPanel>
                        <UniformGrid Columns="3" Height="220" Width="760" HorizontalAlignment="Center">
                            <Border Style="{StaticResource Card}" Background="#1AFFFFFF" Margin="10" Padding="20" VerticalAlignment="Center">
                                <Border.RenderTransform><TranslateTransform x:Name="Tile1Float" /></Border.RenderTransform>
                                <StackPanel>
                                    <Border Width="50" Height="50" CornerRadius="15" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left">
                                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="22" Foreground="White" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{h:Loc Wel_F1_Title}" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,4" />
                                    <TextBlock Text="{h:Loc Wel_F1_Text}" Foreground="#FFB4BCD0" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Background="#1AFFFFFF" Margin="10" Padding="20" VerticalAlignment="Center">
                                <Border.RenderTransform><TranslateTransform x:Name="Tile2Float" /></Border.RenderTransform>
                                <StackPanel>
                                    <Border Width="50" Height="50" CornerRadius="15" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left">
                                        <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="22" Foreground="White" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{h:Loc Wel_F2_Title}" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,4" />
                                    <TextBlock Text="{h:Loc Wel_F2_Text}" Foreground="#FFB4BCD0" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Background="#1AFFFFFF" Margin="10" Padding="20" VerticalAlignment="Center">
                                <Border.RenderTransform><TranslateTransform x:Name="Tile3Float" /></Border.RenderTransform>
                                <StackPanel>
                                    <Border Width="50" Height="50" CornerRadius="15" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left">
                                        <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" FontSize="22" Foreground="White" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{h:Loc Wel_F3_Title}" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,4" />
                                    <TextBlock Text="{h:Loc Wel_F3_Text}" Foreground="#FFB4BCD0" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="{h:Loc Wel_S4_Kicker}" Style="{StaticResource Kicker}" Margin="0,16,0,0" />
                        <TextBlock Text="{h:Loc Wel_S4_Title}" Style="{StaticResource BigTitle}" />
                        <TextBlock Text="{h:Loc Wel_S4_Text}" Style="{StaticResource Lead}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                            <Button Style="{StaticResource AccentButton}" Command="{Binding FinishCommand}" Padding="30,14" FontSize="16" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{h:Loc Wel_Start}" />
                                    <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" Foreground="White" FontSize="14" Margin="10,1,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenGuideCommand}" Padding="24,14" FontSize="16" Background="#14FFFFFF" BorderBrush="#33FFFFFF" Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE897;" Style="{StaticResource Icon}" Foreground="#FFA78BFA" FontSize="15" Margin="0,0,10,0" />
                                    <TextBlock Text="{h:Loc Wel_Guide}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Alt: noktalar + ileri -->
            <Grid Grid.Row="2">
                <ItemsControl ItemsSource="{Binding Dots}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                    Cursor="Hand" Margin="4,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Dot" Width="10" Height="10" CornerRadius="5" Background="#33FFFFFF" />
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource SameValue}">
                                                        <Binding />
                                                        <Binding Path="DataContext.Index" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter TargetName="Dot" Property="Width" Value="32" />
                                                <Setter TargetName="Dot" Property="Background" Value="{StaticResource AccentGradientH}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button HorizontalAlignment="Right" Style="{StaticResource AccentButton}" Command="{Binding NextCommand}" Padding="26,11"
                        Visibility="{Binding IsLast, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{h:Loc Wel_Next}" />
                        <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" Foreground="White" FontSize="13" Margin="10,1,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
