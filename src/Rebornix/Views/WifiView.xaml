<UserControl x:Class="Rebornix.Views.WifiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="clr-namespace:Rebornix.Helpers"
             xmlns:vm="clr-namespace:Rebornix.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:WifiViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">
            <TextBlock Text="{h:Loc Wifi_Title}" Style="{StaticResource H1}" />
            <TextBlock Text="{h:Loc Wifi_Subtitle}" Style="{StaticResource Dim}" Margin="0,6,0,16" />

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IsBackupEnabled}" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="{h:Loc Wifi_ToggleTitle}" Style="{StaticResource H3}" />
                        <TextBlock Text="{h:Loc Wifi_ToggleDesc}" Style="{StaticResource Dim}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource WarnBanner}" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                    <TextBlock Text="{h:Loc Wifi_SecurityNote}" Style="{StaticResource Body}" MaxWidth="900" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding IsBackupEnabled, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="0,18,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{h:Loc Wifi_HideAll}" Command="{Binding HideAllPasswordsCommand}" Margin="0,0,8,0" />
                        <Button Content="{h:Loc Wifi_Reload}" Command="{Binding LoadCommand}" Style="{StaticResource AccentButton}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" />
                        <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <Grid Margin="41,0,14,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{h:Loc Wifi_ColName}" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="1" Text="{h:Loc Wifi_ColSecurity}" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="2" Text="{h:Loc Wifi_ColPassword}" Style="{StaticResource Caption}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InnerCard}" Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}" Margin="12,0,8,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding Authentication}" Style="{StaticResource Dim}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding PasswordDisplay}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ToggleButton Grid.Column="4" Style="{StaticResource EyeToggle}" IsChecked="{Binding IsPasswordVisible}"
                                                          ToolTip="{h:Loc Wifi_ShowHide}" HorizontalAlignment="Right"
                                                          Visibility="{Binding HasPassword, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
