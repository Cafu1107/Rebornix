<UserControl x:Class="Rebornix.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="clr-namespace:Rebornix.Helpers"
             xmlns:vm="clr-namespace:Rebornix.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:DriversViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">
            <TextBlock Text="{h:Loc Drivers_Title}" Style="{StaticResource H1}" />
            <TextBlock Text="{h:Loc Drivers_Subtitle}" Style="{StaticResource Dim}" Margin="0,6,0,16" />

            <Border Style="{StaticResource Banner}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource InfoBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                    <TextBlock Text="{h:Loc Drivers_InfoNote}" Style="{StaticResource Body}" MaxWidth="900" />
                </StackPanel>
            </Border>

            <DockPanel Margin="0,16,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{h:Loc Btn_SelectAll}" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" />
                    <Button Content="{h:Loc Drivers_OnlyCritical}" Command="{Binding SelectOnlyCriticalCommand}" Margin="0,0,8,0" />
                    <Button Command="{Binding LoadCommand}" Style="{StaticResource AccentButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Foreground="White" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{h:Loc Drivers_LoadList}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" />
                    <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{h:Loc Drivers_NotLoaded}" Style="{StaticResource Dim}" Margin="0,20"
                       Visibility="{Binding IsLoaded, Converter={StaticResource InvBoolToVis}}" />

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Badge}" Background="{StaticResource DangerSoftBrush}" Margin="12,0,0,0"
                                            Visibility="{Binding IsCritical, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{h:Loc Drivers_CriticalBadge}" Style="{StaticResource BadgeText}" Foreground="{StaticResource DangerBrush}" />
                                    </Border>
                                </StackPanel>
                                <Grid Margin="31,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{h:Loc Drivers_ColName}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{h:Loc Drivers_ColProvider}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="2" Text="{h:Loc Drivers_ColVersion}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="3" Text="{h:Loc Drivers_ColDate}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="4" Text="{h:Loc Drivers_ColSize}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InnerCard}" Margin="0,3" Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="3*" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                            <Border Style="{StaticResource Badge}" Background="{StaticResource DangerSoftBrush}" Margin="8,0,0,0" Padding="7,1"
                                                                    Visibility="{Binding IsCritical, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{h:Loc Drivers_CriticalShort}" Style="{StaticResource BadgeText}" FontSize="10.5" Foreground="{StaticResource DangerBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                            <Run Text="{Binding Info.InfName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Info.PublishedName, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Info.Provider}" Style="{StaticResource Body}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Info.Version}" Style="{StaticResource Body}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Info.Date}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{Binding SizeText}" Style="{StaticResource Body}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
