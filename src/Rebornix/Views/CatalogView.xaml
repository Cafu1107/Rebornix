<UserControl x:Class="Rebornix.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="clr-namespace:Rebornix.Helpers"
             xmlns:vm="clr-namespace:Rebornix.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CatalogViewModel}">
    <UserControl.Resources>
        <!-- Kartın tamamı tıklanabilir bir onay kutusu -->
        <Style x:Key="CardCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5"
                                CornerRadius="14" Padding="16,14">
                            <Grid>
                                <ContentPresenter />
                                <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5" BorderBrush="{StaticResource TextDimBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Path x:Name="Mark" Data="M 4,10 L 8,13.5 L 15,6" Stroke="White" StrokeThickness="2.2" StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding InstallCommand}" Padding="22,11" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,10,0" />
                    <TextBlock Text="{h:Loc Catalog_Install}" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="{h:Loc Catalog_Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{h:Loc Catalog_Subtitle}" Style="{StaticResource Dim}" Margin="0,6,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Arama / filtre -->
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,7,10,7" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="12,0,0,0"
                           HorizontalAlignment="Left" IsHitTestVisible="False" />
            </Grid>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Margin="10,0,0,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Content="{h:Loc Btn_SelectAll}" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" />
                <Button Content="{h:Loc Btn_Clear}" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding DetectInstalledCommand}" ToolTip="{h:Loc Catalog_Redetect}" />
            </StackPanel>
        </Grid>

        <!-- Profiller -->
        <Border Grid.Row="2" Style="{StaticResource InnerCard}" Margin="0,12,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionText}" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                           VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="{Binding StatusText}" />
                <WrapPanel>
                    <TextBlock Text="{h:Loc Catalog_Profile}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile}" Width="200" Margin="0,2,10,2" />
                    <Button Content="{h:Loc Catalog_ProfileLoad}" Command="{Binding LoadProfileCommand}" Margin="0,2,8,2" />
                    <Button Content="{h:Loc Catalog_ProfileSave}" Command="{Binding SaveProfileCommand}" Margin="0,2,8,2" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding DeleteProfileCommand}" ToolTip="{h:Loc Catalog_ProfileDelete}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE70F;" Command="{Binding OpenCatalogFileCommand}" ToolTip="{h:Loc Catalog_EditFile}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Kartlar -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding View}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Style="{StaticResource CardCheck}" IsChecked="{Binding IsSelected}" Width="262" Height="150" Margin="0,0,12,12"
                                  IsEnabled="{Binding IsInstalled, Converter={StaticResource InvBool}}" ToolTip="{Binding Id}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentGradient}">
                                        <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="12,0,26,0" VerticalAlignment="Center" MaxWidth="170">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CategoryName}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                                    <Border Style="{StaticResource Badge}" Background="{StaticResource SuccessSoftBrush}" Margin="0,0,6,0"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{h:Loc Catalog_InstalledBadge}" Style="{StaticResource BadgeText}" Foreground="{StaticResource SuccessBrush}" />
                                    </Border>
                                    <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource StatusBadge}">
                                        <ContentPresenter.Style>
                                            <Style TargetType="ContentPresenter">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.Status, RelativeSource={RelativeSource AncestorType=CheckBox}}" Value="Pending">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.IsInstalled, RelativeSource={RelativeSource AncestorType=CheckBox}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentPresenter.Style>
                                    </ContentPresenter>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,10,0,6" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Message}" />
                            </DockPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="4" Margin="0,10,0,0" Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Right" Content="{h:Loc Restore_RetryFailed}" Command="{Binding RetryFailedCommand}" Style="{StaticResource AccentButton}" />
            <TextBlock Text="{h:Loc Catalog_HasFailures}" Style="{StaticResource Body}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
