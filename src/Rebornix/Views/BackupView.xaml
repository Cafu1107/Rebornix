<UserControl x:Class="Rebornix.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="clr-namespace:Rebornix.Helpers"
             xmlns:vm="clr-namespace:Rebornix.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:BackupViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding StartBackupCommand}" Padding="22,11" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,10,0" />
                        <TextBlock Text="{h:Loc Backup_Start}" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{h:Loc Backup_Title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{h:Loc Backup_Subtitle}" Style="{StaticResource Dim}" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Hedef -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="{h:Loc Backup_TargetTitle}" Style="{StaticResource H3}" />
                    <TextBlock Text="{h:Loc Backup_TargetDesc}" Style="{StaticResource Dim}" Margin="0,4,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="240" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="Display" />
                        <TextBox Grid.Column="1" Text="{Binding BackupRoot, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" />
                        <Button Grid.Column="2" Content="{h:Loc Btn_Browse}" Command="{Binding BrowseRootCommand}" Margin="10,0,0,0" />
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshDrivesCommand}"
                                ToolTip="{h:Loc Btn_Refresh}" Margin="4,0,0,0" />
                    </Grid>
                    <Border Style="{StaticResource DangerBanner}" Margin="0,14,0,0" Padding="16,14"
                            Visibility="{Binding IsSystemDriveSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="26" Foreground="{StaticResource DangerBrush}" Margin="0,0,14,0" />
                            <StackPanel MaxWidth="820">
                                <TextBlock Text="{h:Loc Backup_SystemDriveTitle}" Style="{StaticResource H3}" Foreground="{StaticResource DangerBrush}" />
                                <TextBlock Text="{h:Loc Backup_SystemDriveBanner}" Style="{StaticResource Body}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- a) Sürücüler -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IncludeDrivers}" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="{h:Loc Backup_DriversTitle}" Style="{StaticResource H3}" />
                        <TextBlock Text="{h:Loc Backup_DriversDesc}" Style="{StaticResource Dim}" Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DriversVm.SelectionText}" Style="{StaticResource Body}" VerticalAlignment="Center"
                                       Visibility="{Binding DriversVm.IsLoaded, Converter={StaticResource BoolToVis}}" />
                            <Button Content="{h:Loc Drivers_LoadList}" Command="{Binding DriversVm.LoadCommand}" Margin="0,0,0,0"
                                    Visibility="{Binding DriversVm.IsLoaded, Converter={StaticResource InvBoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{h:Loc Backup_DriversHint}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- b) Wi-Fi -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding WifiVm.IsBackupEnabled}" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="{h:Loc Backup_WifiTitle}" Style="{StaticResource H3}" />
                        <TextBlock Text="{h:Loc Backup_WifiDesc}" Style="{StaticResource Dim}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding WifiVm.SelectionText}" Style="{StaticResource Body}" Margin="0,8,0,0"
                                   Visibility="{Binding WifiVm.IsBackupEnabled, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- c) Uygulama listesi -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IncludeApps}" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="{h:Loc Backup_AppsTitle}" Style="{StaticResource H3}" />
                        <TextBlock Text="{h:Loc Backup_AppsDesc}" Style="{StaticResource Dim}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- d) Save'ler -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IncludeSaves}" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="{h:Loc Backup_SavesTitle}" Style="{StaticResource H3}" />
                            <TextBlock Text="{h:Loc Backup_SavesDesc}" Style="{StaticResource Dim}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Visibility="{Binding IncludeSaves, Converter={StaticResource BoolToVis}}">
                        <WrapPanel Margin="0,12,0,0">
                            <Border Style="{StaticResource Badge}" Margin="0,0,10,6">
                                <TextBlock Text="{Binding LudusaviStatus}" Style="{StaticResource BadgeText}" />
                            </Border>
                            <Button Content="{h:Loc Saves_Download}" Command="{Binding DownloadLudusaviCommand}" Margin="0,0,8,6" />
                            <Button Content="{h:Loc Saves_Scan}" Command="{Binding ScanGamesCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,6" />
                            <Button Content="{h:Loc Btn_SelectAll}" Command="{Binding SelectAllGamesCommand}" CommandParameter="1" Margin="0,0,8,6" />
                            <Button Content="{h:Loc Btn_SelectNone}" Command="{Binding SelectAllGamesCommand}" CommandParameter="0" Margin="0,0,8,6" />
                        </WrapPanel>
                        <TextBlock Text="{Binding GamesSelectionText}" Style="{StaticResource Caption}" Margin="0,4,0,6" />
                        <Border Style="{StaticResource InnerCard}" Padding="6" MaxHeight="300">
                            <ListBox ItemsSource="{Binding Games}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PlainItem}"
                                     VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <TextBlock Text="{h:Loc Custom_Title}" Style="{StaticResource H3}" Margin="0,18,0,4" />
                        <TextBlock Text="{h:Loc Custom_Desc}" Style="{StaticResource Dim}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="{h:Loc Custom_Add}" Command="{Binding AddCustomFolderCommand}" Margin="0,0,8,6" />
                            <Button Content="{h:Loc Custom_AddMyGames}" Command="{Binding AddSuggestedCommand}" CommandParameter="mygames" Margin="0,0,8,6" />
                            <Button Content="{h:Loc Custom_AddSavedGames}" Command="{Binding AddSuggestedCommand}" CommandParameter="savedgames" Margin="0,0,8,6" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding CustomFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InnerCard}" Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding TokenPath}" />
                                                <TextBlock Text="{Binding ResolvedPath}" Style="{StaticResource Caption}" Margin="29,2,0,0" />
                                            </StackPanel>
                                            <ContentPresenter Grid.Column="1" Content="{Binding Status}" ContentTemplate="{StaticResource StatusBadge}" Margin="10,0" />
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="{h:Loc Btn_Remove}"
                                                    Command="{Binding DataContext.RemoveCustomFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- e) Windows ayarları -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IncludeSettings}" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="{h:Loc Backup_SettingsTitle}" Style="{StaticResource H3}" />
                            <TextBlock Text="{h:Loc Backup_SettingsDesc}" Style="{StaticResource Dim}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding WinSettingsVm.Choices}" Margin="0,12,0,0"
                                  Visibility="{Binding IncludeSettings, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,8,8">
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Title}" ToolTip="{Binding Description}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Banner}" Margin="0,14,0,0">
                <TextBlock Text="{h:Loc Home_BrowserNote}" Style="{StaticResource Body}" />
            </Border>

            <!-- Özet -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{h:Loc Backup_DoneTitle}" Style="{StaticResource H3}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding SummaryLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
