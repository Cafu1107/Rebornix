<UserControl x:Class="Rebornix.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="clr-namespace:Rebornix.Helpers"
             xmlns:vm="clr-namespace:Rebornix.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:OnboardingViewModel}">
    <Grid Background="#E00A0C12">
        <Border MaxWidth="900" MaxHeight="640" Margin="36,20" VerticalAlignment="Center" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.55" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ContentControl Grid.RowSpan="2" Content="{Binding Current, NotifyOnTargetUpdated=True}" Focusable="False">
                    <ContentControl.Triggers>
                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ContentControl.Triggers>
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:OnboardingPage}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Renkli başlık şeridi -->
                                <Border Background="{StaticResource AccentGradient}" CornerRadius="19,19,0,0" Padding="30,24,70,24">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="60" Height="60" CornerRadius="18" Background="#33FFFFFF" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="28" Foreground="White" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                            <Border Style="{StaticResource Badge}" Background="#33FFFFFF">
                                                <TextBlock Text="{Binding Badge}" Style="{StaticResource BadgeText}" Foreground="White" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="Bold" Foreground="White" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,20,30,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Intro}" Style="{StaticResource Body}" FontSize="14.5" Foreground="{StaticResource TextDimBrush}" />
                                        <ItemsControl ItemsSource="{Binding Steps}" AlternationCount="100" Margin="0,14,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource PlusOne}}"
                                                                       FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}" FontSize="14" Margin="12,3,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Style="{StaticResource WarnBanner}" Margin="0,14,0,6" Visibility="{Binding HasTip, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE82F;" Style="{StaticResource Icon}" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                                <TextBlock Text="{Binding Tip}" Style="{StaticResource Body}" MaxWidth="740" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- Kapat -->
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" Foreground="White" FontSize="15" Command="{Binding CloseCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,18,0" ToolTip="{h:Loc Onb_Close}" />

                <!-- Alt çubuk -->
                <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{h:Loc Onb_Back}" Command="{Binding BackCommand}" Margin="0,0,10,0" MinWidth="90" />
                            <Button Command="{Binding NextCommand}" MinWidth="120">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                        <Setter Property="Content" Value="{h:Loc Onb_Next}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                <Setter Property="Content" Value="{h:Loc Onb_Finish}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding Pages}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Cursor="Hand" Margin="0,0,7,0" ToolTip="{Binding Title}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Dot" Width="9" Height="9" CornerRadius="5" Background="{StaticResource Surface3Brush}" />
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource SameObject}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.Current" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter TargetName="Dot" Property="Width" Value="26" />
                                                            <Setter TargetName="Dot" Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding StepText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,22,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Son sayfada hızlı başlangıç düğmeleri -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="30,4,0,18"
                            Visibility="{Binding IsLast, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding StartCommand}" CommandParameter="backup" Style="{StaticResource AccentButton}" Margin="0,0,10,0" Padding="18,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock Text="{h:Loc Onb_StartBackup}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StartCommand}" CommandParameter="restore" Margin="0,0,10,0" Padding="18,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="{h:Loc Onb_StartRestore}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StartCommand}" CommandParameter="catalog" Padding="18,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="{h:Loc Onb_StartCatalog}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
