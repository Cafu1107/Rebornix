<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Gece modu renkleri. Colors.Light.xaml ile aynı anahtarlara sahip olmalı. -->

    <Color x:Key="BgColor">#FF0A0C13</Color>
    <Color x:Key="SidebarColor">#FF0F121B</Color>
    <Color x:Key="SurfaceColor">#FF141824</Color>
    <Color x:Key="Surface2Color">#FF1B2030</Color>
    <Color x:Key="Surface3Color">#FF252B3E</Color>
    <Color x:Key="BorderColor">#FF232A3C</Color>
    <Color x:Key="TextColor">#FFEEF0F6</Color>
    <Color x:Key="TextDimColor">#FF8E97AD</Color>
    <Color x:Key="AccentColor">#FF7B61FF</Color>
    <Color x:Key="AccentHoverColor">#FF9480FF</Color>
    <Color x:Key="AccentPressedColor">#FF6649F2</Color>
    <Color x:Key="AccentSoftColor">#FF221E45</Color>
    <Color x:Key="SuccessColor">#FF34D399</Color>
    <Color x:Key="WarningColor">#FFFBBF24</Color>
    <Color x:Key="DangerColor">#FFF87171</Color>
    <Color x:Key="InfoColor">#FF60A5FA</Color>
    <Color x:Key="SidebarGlowColor">#557B61FF</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#26FBBF24" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#26F87171" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#2260A5FA" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2234D399" />

    <!-- İnce katmanlar (fareyle üzerine gelme, çerçeve) -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#FFD9D2FF" />
    <SolidColorBrush x:Key="ChipBlueFg" Color="#FFBFDBFE" />
    <SolidColorBrush x:Key="ChipGreenFg" Color="#FFA7F3D0" />
    <SolidColorBrush x:Key="ChipPinkFg" Color="#FFFBCFE8" />

    <!-- Marka gradyanı: mor → indigo → mavi -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8B5CF6" Offset="0" />
        <GradientStop Color="#FF6366F1" Offset="0.5" />
        <GradientStop Color="#FF3B82F6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF9D76F8" Offset="0" />
        <GradientStop Color="#FF7A7DF4" Offset="0.5" />
        <GradientStop Color="#FF5595F8" Offset="1" />
    </LinearGradientBrush>
    <!-- Yazılarda kullanılan yatay gradyan -->
    <LinearGradientBrush x:Key="AccentGradientH" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFA78BFA" Offset="0" />
        <GradientStop Color="#FF818CF8" Offset="0.5" />
        <GradientStop Color="#FF60A5FA" Offset="1" />
    </LinearGradientBrush>
    <!-- Kartların üst kenarındaki ince ışık -->
    <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1FFFFFFF" Offset="0" />
        <GradientStop Color="#0AFFFFFF" Offset="0.4" />
        <GradientStop Color="#08FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SelectedNavBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#447B61FF" Offset="0" />
        <GradientStop Color="#107B61FF" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
